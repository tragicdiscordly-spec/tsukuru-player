pkgname=ps5-payload-sdl2
pkgver=r12265.ee4c47d
pkgrel=3
pkgdesc='A library for portable low-level access to video, audio, joysticks...'
arch=('any')
url='https://libsdl.org'
license=('LGPL')
options=(!strip libtool staticlibs)
source=('git+https://github.com/ps5-payload-dev/SDL.git' '0001-ps5-request-32MB-direct-memory.patch'
        '0002-ps5-deferred-flip-wait.patch')
sha256sums=('SKIP' 'SKIP' 'SKIP')
groups=('ps5-payload-dev' 'ps5-payload-sdl2')
depends=('ps5-payload-libsamplerate')
makedepends=('ps5-payload-sdk' 'ps5-payload-libcxx')

prepare() {
    if [ -z "${PS5_PAYLOAD_SDK}" ]; then
	export PS5_PAYLOAD_SDK=/opt/ps5-payload-sdk
    fi

    cd "${srcdir}/SDL"
    patch -Np1 -i "${srcdir}/0001-ps5-request-32MB-direct-memory.patch"
    patch -Np1 -i "${srcdir}/0002-ps5-deferred-flip-wait.patch"
}

pkgver() {
    cd SDL
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
    source "${PS5_PAYLOAD_SDK}/toolchain/prospero.sh"
    cd SDL

    ${CMAKE} -DCMAKE_BUILD_TYPE=Release \
	     -DSDL_OPENGL=YES \
	     -DSDL_LOADSO=YES \
	     -B build \
             -S .
    ${MAKE} -C build
}

package() {
    source "${PS5_PAYLOAD_SDK}/toolchain/prospero.sh"
    cd SDL

    export DESTDIR="${pkgdir}/${DESTDIR}"
    ${MAKE} -C build install

    ${PS5_CROSS_FIX_ROOT} "${DESTDIR}/${PREFIX}"

    mkdir -p "${pkgdir}/${PS5_PAYLOAD_SDK}/bin"
    ln -s "../target/${PREFIX}/bin/sdl2-config" \
       "${pkgdir}/${PS5_PAYLOAD_SDK}/bin/prospero-sdl2-config"
}

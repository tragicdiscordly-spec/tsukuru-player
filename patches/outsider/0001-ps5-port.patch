+    if (dw > pw) dw = pw;
+    if (dh > ph) dh = ph;
+    if (dw < 1) dw = 1;
+    if (dh < 1) dh = 1;
+    int dx = (pw - dw) / 2, dy = (ph - dh) / 2;

+    engine->profile_total_ms += dt_ms;
+    prof_add(0, key, dt_ms);
+    prof_add(1, file_key[0] ? file_key : "(native / no file)", dt_ms);
+    prof_add(2, game_key[0] ? game_key : "(shims / native only)", dt_ms);
+}

+    const char *env = getenv("RMMZ_CANVAS_THREADS");
+    if (env && *env) want = atoi(env);
+    if (want > PAR_MAX_WORKERS) want = PAR_MAX_WORKERS;
+    for (int i = 0; i < want; i++) {
+        pthread_t t;
+        if (pthread_create(&t, NULL, par_worker, NULL) != 0) break;
+        pthread_detach(t);
+        par_worker_count++;

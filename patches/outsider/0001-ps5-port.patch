+void present_cpu_scale(const uint8_t *src, int sw, int sh, int src_bottom_up,
+                       uint8_t *dst, int dst_pitch, int pw, int ph, int mode)
+{
+    if (!src || !dst || sw <= 0 || sh <= 0 || pw <= 0 || ph <= 0) return;

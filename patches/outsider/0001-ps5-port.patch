+                if (c < 48 || c > 57) break;
+                j++;
+            }
+            if (j === i + 1) {
+                i = s.indexOf("%", i + 1);
+                continue;
+            }
+            out += s.substring(last, i) + a[Number(s.substring(i + 1, j)) - 1];
+            last = j;
+            i = s.indexOf("%", last);

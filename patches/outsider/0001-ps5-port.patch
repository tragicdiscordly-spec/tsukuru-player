+    if (g->fast_packed && x1 - x0 >= 8 && have_avx2()) {
+        int done = gradient_blocks_avx2(dst, x0, x1, fcx, dy2, inv, last, g->fast_packed);
+        px += done;
+        dst += (size_t)done * 4;
+    }
+#endif
+    for (; px < x1; px++, dst += 4) {
+        float dx = (px + 0.5f) - fcx;
+        int idx = (int)((dx * dx + dy2) * inv);
+        if (idx > last) idx = last;
+        const FastEntry *e = &fast[idx];
+        uint32_t a = e->a;
+        if (a == 0) continue;

+        uint32_t v = DIV255(e->pr + dst[0] * da + 127);
+        dst[0] = (uint8_t)(v > 255 ? 255 : v);
+        v = DIV255(e->pg + dst[1] * da + 127);
+        dst[1] = (uint8_t)(v > 255 ? 255 : v);
+        v = DIV255(e->pb + dst[2] * da + 127);
+        dst[2] = (uint8_t)(v > 255 ? 255 : v);
+        v = a + da;
+        dst[3] = (uint8_t)(v > 255 ? 255 : v);
+    }

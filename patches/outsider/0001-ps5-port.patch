+        var n = s.length, out = "", last = 0;
+        while (i >= 0) {
+            var j = i + 1;
+            while (j < n) {
+                var c = s.charCodeAt(j);
+                if (c < 48 || c > 57) break;
+                j++;
+            }
+            if (j === i + 1) {
+                i = s.indexOf("%", i + 1);
+                continue;
+            }
+            out += s.substring(last, i) + a[Number(s.substring(i + 1, j)) - 1];
+            last = j;
+            i = s.indexOf("%", last);

+        var h = 0x811c9dc5;
+        for (var i = 0; i < text.length; i++) {
+            h ^= text.charCodeAt(i);
+            h = Math.imul(h, 0x01000193) >>> 0;
+        }
+        return h;
+    }
+
+    function same(fn, hash) {
+        if (typeof fn !== "function") return false;
+        return fingerprint(Function.prototype.toString.call(fn).replace(/\s+/g, "")) === hash;
+    }

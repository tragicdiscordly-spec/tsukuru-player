+            double sv[5];
+            for (int k = 0; k < 5; k++) {
+                JSValue e = JS_GetPropertyUint32(ctx, argv[13], (uint32_t)(i * 5 + k));
+                int rc = JS_ToFloat64(ctx, &sv[k], e);

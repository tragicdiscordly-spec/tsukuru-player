+/* fillGradient(handle, x, y, w, h, radial, p0, p1, p2, p3, stops) where stops is a flat array
+   [offset, r, g, b, a, offset, r, g, b, a, ...] sorted by offset */
+static JSValue js_c2d_fill_gradient(JSContext *ctx, JSValueConst this_val,

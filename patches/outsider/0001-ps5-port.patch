+void platform_get_window_size(Platform *p, int *w, int *h)
+{
+    if (!p || !p->window) return;
+    /* The game sees a window of the size it is drawn at; the screen is scaled to at the end. */
+    if (p->vw > 0 && p->vh > 0) {
+        if (w) *w = p->vw;
+        if (h) *h = p->vh;
+        return;
+    }
+    SDL_GetWindowSize(p->window, w, h);
+}

+struct main_args {
+    int argc;
+    char **argv;
+    int result;
+};
+
+static void *main_thread(void *p)
+{
+    struct main_args *a = (struct main_args *)p;
+    a->result = real_main(a->argc, a->argv);
+    return NULL;

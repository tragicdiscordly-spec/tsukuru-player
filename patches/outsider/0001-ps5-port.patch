+        while ((m = re.exec(css)) !== null) {
+            var fam = /font-family\s*:\s*["']?([^"';]+?)["']?\s*;/i.exec(m[1] + ";");
+            var src = /url\(\s*["']?([^"')]+)["']?\s*\)/i.exec(m[1]);
+            if (!fam || !src) continue;
+            var path = joinPath(dir, decodeURI(src[1]));
+            document.fonts.add(new FontFace(fam[1], "url(" + path + ")"));
+        }
+    }

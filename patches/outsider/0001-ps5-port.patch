+            int x0 = (int)floor(fu);
+            double w = fu - x0;
+            if (x0 < 0) { x0 = 0; w = 0; }
+            if (x0 >= sw - 1) { x0 = sw - 1; w = 0; }
+            job.xi[x] = x0;
+            job.xw[x] = (uint16_t)(w * 256.0 + 0.5);
+        }
+    }

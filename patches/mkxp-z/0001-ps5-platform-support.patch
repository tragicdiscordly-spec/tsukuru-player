+#ifdef __FreeBSD__
+/* Scripts written for RPG Maker XP (Ruby 1.8) often have regular expressions made of raw bytes, such as
+ * FullWidthNumber = /(?:\xef\xbc[\x90-\x99])/ . Ruby 1.8 worked on bytes; newer Ruby refuses the literal as broken
+ * UTF-8 ("too short escaped multibyte character"). A script with such a line is run as a byte script (as in Ruby 1.8)
+ * by giving it a binary source encoding. */
+static std::string fixLegacyScript(const char *text, size_t len) {
+    static const std::regex literal(R"(^.*=\s*/.*\\x[89a-fA-F][0-9a-fA-F].*/\s*(#.*)?$)");
+    std::string src(text, len);
+    if (src.find("\\x") == std::string::npos)
+        return src;
+    size_t pos = 0;
+    while (pos < src.size()) {
+        size_t end = src.find('\n', pos);
+        std::string line = src.substr(pos, end == std::string::npos ? std::string::npos : end - pos);
+        if (!line.empty() && line.back() == '\r')
+            line.pop_back();
+        if (line.find("\\x") != std::string::npos && std::regex_match(line, literal))
+            return "# coding: ascii-8bit\n" + src;
+        if (end == std::string::npos)
+            break;
+        pos = end + 1;
+    }
+    return src;
+}
+#endif
+
+#ifdef __FreeBSD__
+/* RPG Maker XP's Ruby accepts a later script that defines "class Foo < Bar" for a class that an earlier script already
+ * defined with another superclass (Pokemon Uranium does this for its bag window); newer Ruby raises "superclass
+ * mismatch". Such a later definition is turned into a plain "class Foo" (the class is reopened, it keeps its first
+ * superclass). Only top-level "class Name < Super" lines are looked at. */
+static std::string fixSuperclassMismatch(const std::string &src, std::map<std::string, std::string> &seen) {
+    static const std::regex classDef(R"(^class\s+([A-Z]\w*)\s*<\s*([A-Z][\w:]*)\s*(#.*)?$)");
+    if (src.find("class ") == std::string::npos)
+        return src;
+    std::string out;
+    out.reserve(src.size());
+    size_t pos = 0;
+    while (pos < src.size()) {
+        size_t end = src.find('\n', pos);
+        std::string line = src.substr(pos, end == std::string::npos ? std::string::npos : end - pos);
+        bool cr = !line.empty() && line.back() == '\r';
+        if (cr)
+            line.pop_back();
+        if (line.compare(0, 6, "class ") == 0) {
+            std::smatch m;
+            if (std::regex_match(line, m, classDef)) {
+                std::string name = m[1].str(), super = m[2].str();
+                auto it = seen.find(name);
+                if (it == seen.end())
+                    seen[name] = super;
+                else if (it->second != super)
+                    line = "class " + name + (m[3].matched ? " " + m[3].str() : "");
+            }
+        }
+        out += line;
+        if (cr)
+            out += '\r';
+        if (end == std::string::npos)
+            break;
+        out += '\n';
+        pos = end + 1;
+    }
+    return out;
+}
+#endif
+
+#ifdef __FreeBSD__
+/* Community scripts that only exist to load native Windows DLLs (RGSS Linker, FmodEx audio). Without them the game
+ * uses the engine's own Audio. MKXP_SKIP_SCRIPTS=name:name adds more (script names, separated by ':'). */
+static bool shouldSkipScript(const char *name) {
+    static const char *const builtin[] = {"RGSS Linker", "F-mod main script"};
+    for (const char *b : builtin)
+        if (strcmp(name, b) == 0)
+            return true;
+    if (const char *env = getenv("MKXP_SKIP_SCRIPTS")) {
+        std::string list(env), wanted(name);
+        size_t start = 0;
+        while (start <= list.size()) {
+            size_t end = list.find(':', start);
+            if (end == std::string::npos)
+                end = list.size();
+            if (end > start && list.compare(start, end - start, wanted) == 0)
+                return true;
+            start = end + 1;
+        }
+    }
+    return false;
+}
+#endif

+#ifdef __FreeBSD__
+/* RPG Maker XP ran Ruby 1.8, where text[5] is the number of the byte at 5; newer Ruby returns a one-letter string.
+ * XP games read their binary data that way, so for XP games String#[] with one integer returns the byte. Everything
+ * else goes to the original method. This is written in C on purpose: a Ruby method in between would keep the match
+ * data ($~) of text[/regexp/] to itself, while C frames let it reach the game's code. */
+static VALUE rgss1StrAref(int argc, VALUE *argv, VALUE self) {
+    if (argc == 1 && FIXNUM_P(argv[0])) {
+        long i = FIX2LONG(argv[0]);
+        long len = RSTRING_LEN(self);
+        if (i < 0)
+            i += len;
+        if (i < 0 || i >= len)
+            return Qnil;
+        return INT2FIX((unsigned char)RSTRING_PTR(self)[i]);
+    }
+    return rb_funcallv(self, rb_intern("__rgss_index"), argc, argv);
+}
+#endif
